{
  "name": "molde-language",
  "displayName": "molde — model language",
  "description": "Language support for .model files (molde): highlighting, formatting, navigation, and dependencies.",
  "version": "0.0.2",
  "publisher": "molde",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:molde"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "molde",
        "aliases": [
          "molde",
          "molde model"
        ],
        "extensions": [
          ".model"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/molde.svg",
          "dark": "./icons/molde.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "molde",
        "scopeName": "source.molde",
        "path": "./syntaxes/molde.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "molde",
      "properties": {
        "molde.server.path": {
          "type": "string",
          "default": "molde-lsp",
          "description": "Path to the molde-lsp language server binary (on PATH by default)."
        },
        "molde.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enables the language server (diagnostics, navigation, dependencies, formatting)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  }
}
