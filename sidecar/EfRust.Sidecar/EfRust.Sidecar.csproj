<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>efrust-sidecar</AssemblyName>
    <RootNamespace>EfRust.Sidecar</RootNamespace>

    <!-- Empaquetado como `dotnet tool` (instalable global o local). Tras
         `dotnet tool install`, invocar con `EFRUST_SIDECAR_CMD=efrust-sidecar`
         (o `dotnet efrust-sidecar`). Ver crates/efrust-design/src/sidecar.rs. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>efrust-sidecar</ToolCommandName>
    <PackageId>EfRust.Sidecar</PackageId>
    <Version>0.1.0</Version>
    <Description>Extrae el modelo de EF Core (IModel) a JSON para efrust.</Description>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <!--
    El sidecar referencia EF Core para aprovechar el modelo YA resuelto
    (Fluent API + data annotations + convenciones). Esa es justamente la pieza
    que evita reimplementar un analizador semántico de C# en Rust.

    En Fase 3 se añade además la referencia al proyecto del usuario (o la carga
    dinámica de su assembly compilado) para obtener su DbContext.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.*" />
  </ItemGroup>

</Project>
